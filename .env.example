# Local defaults. VPS bootstrap generates its own ignored .env; see
# scripts/vps-bootstrap.sh. NODE_ENV is normally set by the runtime/build.
DEPLOYED_ENV="local" # Compose requires this; use production/development on VPS.
COMPOSE_PROJECT_NAME="democracyonline-local" # Isolates this Compose stack.
APP_PORT="3000" # Host port; local dev profile commonly uses 3001.
DB_PASSWORD="local-only-password" # Compose Postgres password; use a unique secret outside local dev.

# App-to-Postgres URL. Compose uses host `db`; for tools on your machine use
# localhost and the published Postgres port. URL-encode special password chars.
DATABASE_URL="postgresql://postgres:local-only-password@localhost:5432/postgres"

# Public canonical origin. Required HTTPS on VPS; used for generated task URLs.
SITE_URL="http://localhost:3000"

# Comma-separated Firebase Auth emails allowed into admin features.
# Firebase Console > Authentication > Users for the exact sign-in email.
ADMIN_EMAILS="admin@example.com"

# Cron authentication. Internal token must match between app and scheduler
# containers (VPS bootstrap generates it). Local token is only for localhost.
# Scheduler token is only needed for externally-triggered/Cloud Tasks requests.
CRON_INTERNAL_TOKEN="local-only-internal-token"
CRON_LOCAL_TOKEN="local-dev-cron-token"
CRON_SCHEDULER_TOKEN=""

# Optional Web Push. Generate a stable key pair with `bunx web-push
# generate-vapid-keys`; private key stays server-side. Subject is a contact URL.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@example.com"

# Optional legacy Google Cloud Tasks integration; leave unset for normal
# local/VPS scheduler operation. Find project/service-account details in
# Google Cloud Console > IAM & Admin and Cloud Tasks.
GCP_PROJECT_ID=""
CLOUD_TASKS_LOCATION=""
ELECTION_TASK_QUEUE=""
ELECTION_TASK_SERVICE_ACCOUNT=""

# Optional scheduler overrides. Normally leave unset: schedules come from the
# selected instance profile and game speed is stored in the database. The
# election multiplier is only a fallback for a fresh DB without a setting.
# Bill advancement is deadline-driven; BILL_ADVANCE_SCHEDULE_UTC is legacy.
# GAME_ADVANCE_SCHEDULE_UTC="0 20 * * *"
# ELECTION_TIME_MULTIPLIER="1"

# Firebase Admin SDK (server only): Firebase Console > Project settings >
# Service accounts > Generate new private key. Copy client_email and private_key
# from that JSON. Keep the private key secret; encode newlines as \\n in .env.
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Same Firebase project as VITE_FIREBASE_PROJECT_ID below.
FIREBASE_PROJECT_ID=""

# Firebase web app config: Firebase Console > Project settings > General >
# Your apps > Web app. VITE_* values are bundled into browser code (not secrets).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Optional Firebase Analytics measurement ID from that same web app config.
VITE_FIREBASE_MEASUREMENT_ID=""

# Optional Auth Emulator endpoints for isolated local/E2E testing only.
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# VITE_FIREBASE_AUTH_EMULATOR_URL="http://127.0.0.1:9099"

# Instance branding/game defaults. Vite reads this file and embeds its JSON;
# use instances/dev.json for the dev profile. Defaults to instances/oscana.json.
VITE_INSTANCE_CONFIG="instances/oscana.json"

# Optional manual VPS database sync helper. SSH alias must be configured in
# ~/.ssh/config; never put a password or private key here. Optional target:
# OSCANA_VPS_ENV="development" (defaults to production).
# OSCANA_VPS_SSH="deploy@your-ssh-alias"

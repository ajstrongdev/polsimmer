{
  "name": "my-app",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "deploy": "bash scripts/vps.sh deploy",
    "deploy:down": "bash scripts/vps.sh stop",
    "deploy:logs": "bash scripts/vps.sh logs",
    "deploy:ps": "bash scripts/vps.sh status",
    "deploy:check": "bash scripts/vps.sh check",
    "deploy:backup": "bash scripts/vps.sh backup",
    "db:sync:vps": "node scripts/sync-vps-db.mjs",
    "update": "bash scripts/vps.sh update",
    "seed:fresh": "node --import tsx scripts/seed-fresh.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "e2e:prepare": "node scripts/e2e/check-env.mjs && bun run db:migrate && bun run seed:fresh && node scripts/e2e/seed-auth.mjs && NODE_ENV=production bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt .",
    "check": "oxfmt . && oxlint --fix .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run db:seed:elections",
    "db:seed:elections": "tsx scripts/seed.ts elections",
    "db:seed:elections-finished": "tsx scripts/seed.ts elections-finished",
    "db:seed:candidate-signup": "tsx scripts/seed.ts candidate-signup",
    "db:seed:primary-winner": "tsx scripts/seed.ts primary-winner",
    "db:seed:midterms": "tsx scripts/seed.ts midterms",
    "db:seed:committee-test": "tsx scripts/seed.ts committee-test",
    "db:seed:fresh": "tsx scripts/seed-fresh.ts",
    "db:seed:users": "tsx scripts/seed-users.ts",
    "db:seed:party-leader": "tsx scripts/seed-party-role.ts leader",
    "db:seed:chief-whip": "tsx scripts/seed-party-role.ts chief-whip",
    "db:seed:social-media-officer": "tsx scripts/seed-party-role.ts social-media-officer",
    "nation:randomize": "tsx scripts/randomize-nation.ts",
    "election:dry-run": "tsx scripts/election-dry-run.ts",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit pull",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ajstrongdev/start-themes": "^1.0.0",
    "@dicebear/adventurer": "^9.4.2",
    "@dicebear/avataaars": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@dicebear/lorelei": "^9.4.2",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@opentelemetry/instrumentation-http": "^0.211.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-core": "^0.13.8",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.10.5",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-router": "^1.170.15",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.24",
    "@tanstack/router-plugin": "^1.168.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.19",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.39.0",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "^10.5.0",
    "lucide-react": "^0.544.0",
    "motion": "^12.25.0",
    "next-themes": "^0.4.6",
    "nitro": "npm:nitro-nightly@latest",
    "pg": "^8.11.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-firebase-hooks": "^5.1.1",
    "react-markdown": "^10.1.0",
    "recharts": "2.15.4",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.6",
    "tw-animate-css": "^1.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "web-push": "^3.6.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tanstack/devtools-vite": "^0.3.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/bun": "1.4.2",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase-tools": "^15.31.0",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "web-vitals": "^5.1.0"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@firebase/util",
    "esbuild",
    "protobufjs",
    "unrs-resolver"
  ]
}
